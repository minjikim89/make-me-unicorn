{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.minjikim89/make-me-unicorn",
  "title": "Make Me Unicorn",
  "description": "Launch gate for AI coding agents: deterministic scan for secrets, open webhooks, missing RLS.",
  "repository": {
    "url": "https://github.com/minjikim89/make-me-unicorn",
    "source": "github"
  },
  "websiteUrl": "https://minjikim89.github.io/make-me-unicorn/",
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "make-me-unicorn",
      "version": "0.9.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=1.27,<3",
          "description": "The MCP SDK is an optional extra of the package; add it to the uvx environment."
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve-mcp"
        }
      ]
    }
  ]
}
