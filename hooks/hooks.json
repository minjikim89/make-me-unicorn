{
  "description": "Make Me Unicorn launch gate: runs `mmu vibecheck` before git commit/push, when the agent is about to stop, and after edits, so launch-blocking gaps are fixed while the agent is still in the loop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/vibecheck_gate.py\" --event pre-shell",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/vibecheck_gate.py\" --event stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/vibecheck_gate.py\" --event post-edit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
